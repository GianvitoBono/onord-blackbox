# Copy to .env for local development. Use a unique password.
POSTGRES_USER=blackbox
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=blackbox
POSTGRES_PORT=5432

# Rust process run from host; adjust password to match above.
DATABASE_URL=postgres://blackbox:change-this-local-password@127.0.0.1:5432/blackbox
BIND_ADDR=127.0.0.1:8080
DASHBOARD_USERNAME=admin
DASHBOARD_COOKIE_SECURE=false
