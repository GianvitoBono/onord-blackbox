# Copy to .env.local; use a random hexadecimal password for this isolated local database.
POSTGRES_PASSWORD=replace-with-long-random-hex-password
LOCAL_HTTP_PORT=8088
# Optional: build-time OSM-derived tile provider and its required attribution.
# VITE_MAP_TILE_URL=https://tile.example.com/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=Map data © OpenStreetMap contributors
