# Copy to .env.nginx on server; reuse existing PostgreSQL password if switching from compose.server.yaml.
POSTGRES_USER=blackbox
POSTGRES_DB=blackbox
POSTGRES_PASSWORD=replace-with-long-random-hex-password
DASHBOARD_USERNAME=admin
VEHICLE_NAME=Giulietta
DEVICE_NAME=OnePlus Nord
NGINX_UPSTREAM_PORT=18088
# Optional: build-time OSM-derived tile provider and its required attribution.
# VITE_MAP_TILE_URL=https://tile.example.com/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=Map data © OpenStreetMap contributors
