# Copy to .env.server. Keep this file private and use a random URL-safe password.
DOMAIN=blackbox.example.com
ACME_EMAIL=you@example.com
POSTGRES_USER=blackbox
POSTGRES_DB=blackbox
POSTGRES_PASSWORD=replace-with-long-random-hex-password
DASHBOARD_USERNAME=admin
VEHICLE_NAME=Giulietta
